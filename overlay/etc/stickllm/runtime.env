# Optional overrides (ephemeral unless Persist config is used)
STICKLLM_MODE=ephemeral
# Do not pin CUDA_VISIBLE_DEVICES here — stickllm-pick-gpus writes /run/stickllm/cuda.env

# v0.3 — LAN TLS (self-signed). Set STICKLLM_TLS=0 only for offline debug.
STICKLLM_TLS=1
STICKLLM_PORT=443
STICKLLM_HTTP_PORT=80

# Native StickLLM UI only (Open WebUI removed from product path)
STICKLLM_CHAT_FRONTEND=native

# On-box kiosk / curl from the stick: no pair code required (LAN still needs pair)
STICKLLM_LOCAL_TRUST=1

# Multi-NVIDIA: 0 = single largest GPU (stable, matches v0.2). auto = all ≥16GB cards.
STICKLLM_MULTI_GPU=0
