[Unit]
Description=StickLLM llama.cpp server (local / LAN)
# network.target (not network-online): StickLLM must start without DHCP wait-online.
After=network.target nvidia-persistenced.service stickllm-nvidia.service stickllm-usb.service
Wants=stickllm-nvidia.service stickllm-usb.service
ConditionPathExists=/opt/stickllm/bin/llama-server

[Service]
Type=simple
EnvironmentFile=-/etc/stickllm/runtime.env
Environment=LD_LIBRARY_PATH=/opt/stickllm/lib
ExecStartPre=/usr/local/bin/stickllm-nvidia-prep
ExecStartPre=/usr/local/bin/stickllm-pick-gpus
ExecStartPre=/usr/local/bin/stickllm-select-model
ExecStart=/usr/local/bin/stickllm-llama-start
Restart=on-failure
RestartSec=5
SupplementaryGroups=video render
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia1 rw
DeviceAllow=/dev/nvidia2 rw
DeviceAllow=/dev/nvidia3 rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
ReadWritePaths=/tmp /run /var/tmp /mnt/stickllm-data
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
