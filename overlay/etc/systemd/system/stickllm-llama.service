[Unit]
Description=StickLLM llama.cpp server (local / LAN)
After=network-online.target nvidia-persistenced.service stickllm-nvidia.service
Wants=network-online.target stickllm-nvidia.service
ConditionPathExists=/opt/stickllm/bin/llama-server

[Service]
Type=simple
EnvironmentFile=-/etc/stickllm/runtime.env
EnvironmentFile=-/run/stickllm/cuda.env
EnvironmentFile=-/run/stickllm/model.env
Environment=LD_LIBRARY_PATH=/opt/stickllm/lib
ExecStartPre=/usr/local/bin/stickllm-nvidia-prep
ExecStartPre=/usr/local/bin/stickllm-pick-gpus
# model.env sets STICKLLM_MODEL after a catalog download; else baked 7B
# Bind loopback only — LAN clients use the TLS gateway (:443), not raw :8080
ExecStart=/bin/bash -c 'exec /opt/stickllm/bin/llama-server --model "${STICKLLM_MODEL:-/opt/stickllm/models/qwen2.5-7b-instruct-q5_k_m-00001-of-00002.gguf}" --host 127.0.0.1 --port 8080 --ctx-size 8192 --n-gpu-layers 999 --threads 8 --metrics'
Restart=on-failure
RestartSec=5
SupplementaryGroups=video render
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidia1 rw
DeviceAllow=/dev/nvidia2 rw
DeviceAllow=/dev/nvidia3 rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=char-nvidia-frontend rw
DeviceAllow=char-nvidia-uvm rw
ReadWritePaths=/tmp /run /var/tmp /mnt/stickllm-data
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
