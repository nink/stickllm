[Unit]
Description=StickLLM chat UI + web gateway (HTTPS :443, HTTP→HTTPS :80)
After=network-online.target stickllm-llama.service stickllm-control.service stickllm-tls.service
Wants=network-online.target stickllm-control.service stickllm-tls.service

[Service]
Type=simple
EnvironmentFile=-/etc/stickllm/runtime.env
Environment=STICKLLM_UI=/opt/stickllm/ui
Environment=STICKLLM_API=http://127.0.0.1:8080
Environment=STICKLLM_BIND=0.0.0.0
Environment=STICKLLM_PORT=443
Environment=STICKLLM_HTTP_PORT=80
Environment=STICKLLM_TLS=1
Environment=STICKLLM_TLS_CERT=/var/lib/stickllm/tls/cert.pem
Environment=STICKLLM_TLS_KEY=/var/lib/stickllm/tls/key.pem
Environment=STICKLLM_CHAT_FRONTEND=auto
Environment=STICKLLM_OPENWEBUI_URL=http://127.0.0.1:8081
ExecStartPre=/usr/local/bin/stickllm-tls
ExecStart=/usr/local/bin/stickllm-gateway
Restart=on-failure
RestartSec=3
# Needs outbound HTTPS when Web lookup is used
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/stickllm /run/stickllm /mnt/stickllm-data

[Install]
WantedBy=multi-user.target
