[Unit]
Description=StickLLM local console chat (this PC screen/keyboard)
ConditionKernelCommandLine=stickllm.local
After=stickllm-llama.service stickllm-ui.service stickllm-bootstatus.service stickllm-console-setup.service
Wants=stickllm-llama.service stickllm-ui.service
Conflicts=getty@tty1.service
ConditionPathExists=/usr/local/bin/stickllm-local-chat

[Service]
Type=simple
ExecStart=/usr/local/bin/stickllm-local-chat
Restart=on-failure
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=STICKLLM_API=https://127.0.0.1
Environment=STICKLLM_TTY=/dev/tty1

[Install]
WantedBy=multi-user.target
