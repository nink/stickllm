[Unit]
Description=StickLLM privileged control API (localhost)
After=local-fs.target stickllm-console-setup.service
# Do not block bootstatus — tty1 progress must paint even if control is slow.
Before=stickllm-ui.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p /run/stickllm
ExecStartPre=/usr/local/bin/stickllm-pair
ExecStart=/usr/local/bin/stickllm-control
Restart=on-failure
RestartSec=2
# Root intentionally — performs USB/model writes after pair-auth via gateway

[Install]
WantedBy=multi-user.target
