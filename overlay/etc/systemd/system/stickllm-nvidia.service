[Unit]
Description=StickLLM NVIDIA UVM / CUDA device prep
DefaultDependencies=no
After=systemd-modules-load.service local-fs.target
Before=stickllm-llama.service nvidia-persistenced.service
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/stickllm-nvidia-prep
ExecStart=/usr/local/bin/stickllm-pick-gpus

[Install]
WantedBy=multi-user.target
