#!/usr/bin/env python3
"""StickLLM UI + chat gateway: pair auth, TLS, native StickLLM UI."""
from __future__ import annotations

import hashlib
import json
import os
import re
import secrets
import ssl
import subprocess
import sys
import threading
import traceback
import urllib.error
import urllib.parse
import urllib.request
from http.cookies import SimpleCookie
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

UI_ROOT = Path(os.environ.get("STICKLLM_UI", "/opt/stickllm/ui"))
LLAMA = os.environ.get("STICKLLM_API", "http://127.0.0.1:8080").rstrip("/")
CONTROL = os.environ.get("STICKLLM_CONTROL", "http://127.0.0.1:8091").rstrip("/")
HOST = os.environ.get("STICKLLM_BIND", "0.0.0.0")
PORT = int(os.environ.get("STICKLLM_PORT", "443"))
HTTP_PORT = int(os.environ.get("STICKLLM_HTTP_PORT", "80"))
TLS_ENABLED = os.environ.get("STICKLLM_TLS", "1").strip().lower() not in ("0", "false", "no", "off")
TLS_CERT = Path(os.environ.get("STICKLLM_TLS_CERT", "/var/lib/stickllm/tls/cert.pem"))
TLS_KEY = Path(os.environ.get("STICKLLM_TLS_KEY", "/var/lib/stickllm/tls/key.pem"))
# Physical console / local kiosk: trust loopback so on-box UI needs no pair code.
# LAN clients still require pair. Set STICKLLM_LOCAL_TRUST=0 to disable.
LOCAL_TRUST = os.environ.get("STICKLLM_LOCAL_TRUST", "1").strip().lower() not in (
    "0",
    "false",
    "no",
    "off",
)
UA = "StickLLM/0.3 (+local privacy USB; paired LAN client)"
VERSION = "0.3"
RUN_DIR = Path(os.environ.get("STICKLLM_RUN", "/run/stickllm"))
AUTH_PATH = RUN_DIR / "auth.json"
COOKIE_NAME = "stickllm_session"
PAIR_BIN = Path(os.environ.get("STICKLLM_PAIR_BIN", "/usr/local/bin/stickllm-pair"))

def http_json(url: str, payload: dict | None = None, timeout: int = 300, headers: dict | None = None) -> dict:
    data = None if payload is None else json.dumps(payload).encode()
    hdrs = {"Content-Type": "application/json", "User-Agent": UA}
    if headers:
        hdrs.update(headers)
    req = urllib.request.Request(
        url,
        data=data,
        headers=hdrs,
        method="GET" if data is None else "POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def http_text(url: str, timeout: int = 12) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read(200_000)
    return raw.decode("utf-8", errors="replace")


def load_auth() -> dict:
    try:
        return json.loads(AUTH_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {"require_pair": False, "paired": False}


def save_auth(doc: dict) -> None:
    AUTH_PATH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    try:
        os.chmod(AUTH_PATH, 0o600)
    except Exception:
        pass


def mint_pair_code() -> str:
    """Force-refresh pair code via stickllm-pair (works even when already paired)."""
    bin_path = str(PAIR_BIN)
    if not Path(bin_path).is_file():
        raise RuntimeError(f"pair helper missing: {bin_path}")
    # Same interpreter as the gateway (avoids shebang/+x and Windows Store stubs).
    cmd = [sys.executable or "python3", bin_path, "--force"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=15, check=False)
    except Exception as e:
        raise RuntimeError(f"pair helper failed: {e}") from e
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "unknown error").strip()
        raise RuntimeError(err[:300] or f"exit {r.returncode}")
    return (r.stdout or "").strip()


def token_hash(token: str) -> str:
    return hashlib.sha256(token.encode()).hexdigest()


def token_ok(token: str | None, doc: dict) -> bool:
    if not token or not doc.get("paired"):
        return False
    return token_hash(token) == doc.get("token_hash")


def bearer_token(header: str | None) -> str | None:
    if not header:
        return None
    parts = header.split()
    if len(parts) != 2 or parts[0].lower() != "bearer":
        return None
    return parts[1]


def cookie_token(cookie_header: str | None) -> str | None:
    if not cookie_header:
        return None
    c = SimpleCookie()
    try:
        c.load(cookie_header)
    except Exception:
        return None
    morsel = c.get(COOKIE_NAME)
    return morsel.value if morsel else None


def duckduckgo_search(query: str, n: int = 5) -> list[dict]:
    body = urllib.parse.urlencode({"q": query, "kl": "us-en"}).encode()
    req = urllib.request.Request(
        "https://html.duckduckgo.com/html/",
        data=body,
        headers={"User-Agent": UA, "Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            html = r.read(400_000).decode("utf-8", errors="replace")
    except Exception as e:
        return [{"title": "search error", "url": "", "snippet": str(e)}]

    results: list[dict] = []
    for m in re.finditer(
        r'class="result__a"[^>]*href="(?P<href>[^"]+)"[^>]*>(?P<title>.*?)</a>'
        r'.*?(?:class="result__snippet"[^>]*>(?P<snip>.*?)</(?:a|td)|$)',
        html,
        re.I | re.S,
    ):
        title = re.sub(r"<[^>]+>", "", m.group("title")).strip()
        snip = re.sub(r"<[^>]+>", "", m.group("snip") or "").strip()
        href = m.group("href")
        um = re.search(r"uddg=([^&]+)", href)
        if um:
            href = urllib.parse.unquote(um.group(1))
        if not title:
            continue
        results.append({"title": title, "url": href, "snippet": snip[:400]})
        if len(results) >= n:
            break
    if not results:
        results.append({"title": "no results", "url": "", "snippet": "Web search returned nothing useful."})
    return results


def fetch_url(url: str) -> str:
    if not url.startswith(("http://", "https://")):
        return "invalid url"
    try:
        text = http_text(url, timeout=12)
    except Exception as e:
        return f"fetch failed: {e}"
    text = re.sub(r"(?is)<script.*?>.*?</script>", " ", text)
    text = re.sub(r"(?is)<style.*?>.*?</style>", " ", text)
    text = re.sub(r"(?is)<[^>]+>", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text[:6000]


def needs_web(text: str) -> bool:
    t = text.lower()
    keys = (
        "http://", "https://", "www.", "search", "look up", "lookup", "look it up",
        "latest", "today", "news", "current", "who is", "what is the price",
        "whats the price", "what's the price", "price of", "how much", "weather",
        "stock", "bitcoin", "btc", "according to", "on the internet", "online",
        "live", "right now",
    )
    return any(k in t for k in keys) or bool(re.search(r"\b20\d{2}\b", t))


def _clip(text: str, n: int) -> str:
    text = (text or "").strip()
    if len(text) <= n:
        return text
    return text[: n - 1].rstrip() + "…"


def augment_with_web(messages: list[dict], force: bool) -> tuple[list[dict], list[dict]]:
    user_text = ""
    for m in reversed(messages):
        if m.get("role") == "user":
            user_text = str(m.get("content") or "")
            break
    if not user_text:
        return messages, []
    if not needs_web(user_text):
        return messages, []

    hits = duckduckgo_search(user_text, n=3)
    page = ""
    if hits and hits[0].get("url"):
        page = _clip(fetch_url(hits[0]["url"]), 1200)

    block_lines = ["Live web results (for this answer only — still use earlier chat turns):"]
    for i, h in enumerate(hits, 1):
        block_lines.append(
            f"{i}. {_clip(h.get('title', ''), 120)}\n"
            f"   {_clip(h.get('url', ''), 200)}\n"
            f"   {_clip(h.get('snippet', ''), 240)}"
        )
    if page:
        block_lines.append("\nTop-page excerpt:\n" + page)
    block = _clip("\n".join(block_lines), 2800)

    sys_parts = [
        str(m.get("content") or "").strip()
        for m in messages
        if m.get("role") == "system" and str(m.get("content") or "").strip()
    ]
    if not sys_parts:
        sys_parts = [
            "You are StickLLM with optional live web lookup. "
            "Use prior conversation turns. Cite URLs briefly when using web results."
        ]
    sys_parts.append(
        "Use earlier turns in this conversation. "
        "Web results below supplement the latest question; they do not replace chat history."
    )
    sys_msg = {"role": "system", "content": "\n\n".join(sys_parts)}

    rest = [m for m in messages if m.get("role") != "system"]
    if len(rest) > 24:
        rest = rest[-24:]
    web_note = {
        "role": "user",
        "content": block + "\n\nUser question:\n" + user_text,
    }
    if rest and rest[-1].get("role") == "user":
        rest = rest[:-1] + [web_note]
    else:
        rest = rest + [web_note]
    return [sys_msg] + rest, hits


def read_json_safe(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(UI_ROOT), **kwargs)

    def log_message(self, fmt: str, *args) -> None:
        sys_stderr = __import__("sys").stderr
        sys_stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def end_headers(self) -> None:
        path = urllib.parse.urlparse(self.path).path
        if path.endswith((".js", ".css", ".html")) or path in ("/", "", "/stickllm", "/stickllm/"):
            self.send_header("Cache-Control", "no-store, max-age=0")
            self.send_header("Pragma", "no-cache")
        super().end_headers()

    def _send(self, code: int, body: bytes, ctype: str = "application/json", extra: list[tuple[str, str]] | None = None) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        if extra:
            for k, v in extra:
                self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code: int, obj: dict, extra: list[tuple[str, str]] | None = None) -> None:
        self._send(code, json.dumps(obj).encode(), extra=extra)

    def _session_token(self) -> str | None:
        return bearer_token(self.headers.get("Authorization")) or cookie_token(self.headers.get("Cookie"))

    def _is_loopback(self) -> bool:
        host = (self.client_address[0] or "").lower()
        return host in ("127.0.0.1", "::1", "localhost")

    def _auth(self) -> tuple[dict, bool]:
        doc = load_auth()
        if LOCAL_TRUST and self._is_loopback():
            return doc, True
        ok = token_ok(self._session_token(), doc)
        return doc, ok

    def _set_session_cookie(self, token: str) -> list[tuple[str, str]]:
        flags = f"{COOKIE_NAME}={token}; Path=/; HttpOnly; SameSite=Strict"
        if TLS_ENABLED:
            flags += "; Secure"
        return [("Set-Cookie", flags)]

    def _clear_session_cookie(self) -> list[tuple[str, str]]:
        flags = f"{COOKIE_NAME}=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0"
        if TLS_ENABLED:
            flags += "; Secure"
        return [("Set-Cookie", flags)]

    def _native_ui(self) -> None:
        # Map /stickllm → static UI root
        parsed = urllib.parse.urlparse(self.path)
        rel = parsed.path
        if rel.startswith("/stickllm"):
            rel = rel[len("/stickllm") :] or "/"
            self.path = rel + (("?" + parsed.query) if parsed.query else "")
        return super().do_GET()

    def do_GET(self) -> None:  # noqa: N802
        path = urllib.parse.urlparse(self.path).path

        if path in ("/health", "/api/health"):
            try:
                data = http_json(LLAMA + "/health", timeout=3)
                data["gateway"] = "ok"
                data["web"] = True
                data["version"] = VERSION
                data["tls"] = TLS_ENABLED
                data["chat_frontend"] = "native"
                auth = load_auth()
                require = bool(auth.get("require_pair", True))
                paired = bool(auth.get("paired"))
                if LOCAL_TRUST and self._is_loopback():
                    require = False
                    paired = True
                data["pair"] = {
                    "require_pair": require,
                    "paired": paired,
                    "local_trust": bool(LOCAL_TRUST and self._is_loopback()),
                }
                self._json(200, data)
            except Exception as e:
                self._json(503, {"status": "down", "error": str(e), "version": VERSION, "tls": TLS_ENABLED})
            return

        if path == "/api/pair/status":
            auth = load_auth()
            require = bool(auth.get("require_pair", True))
            paired = bool(auth.get("paired"))
            if LOCAL_TRUST and self._is_loopback():
                require = False
                paired = True
            self._json(
                200,
                {
                    "require_pair": require,
                    "paired": paired,
                    "local_trust": bool(LOCAL_TRUST and self._is_loopback()),
                    "tls": TLS_ENABLED,
                    "chat_frontend": "native",
                    "hint": "Enter the 6-digit code shown on the StickLLM computer screen.",
                },
            )
            return

        if path in ("/api/storage", "/api/models/status"):
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            storage = read_json_safe(RUN_DIR / "storage.json") or {
                "mounted": False,
                "note": "USB data not claimed yet",
            }
            probe = read_json_safe(RUN_DIR / "model-probe.json") or {}
            self._json(200, {"version": VERSION, "storage": storage, "probe": probe})
            return

        if path == "/api/web/search":
            doc, ok = self._auth()
            if doc.get("require_pair") and not ok:
                self._json(401, {"error": "pair_required"})
                return
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("q", [""])[0]
            hits = duckduckgo_search(q or "StickLLM", n=5)
            self._json(200, {"results": hits})
            return

        if path.startswith("/stickllm"):
            return self._native_ui()

        return self._native_ui()

    def do_POST(self) -> None:  # noqa: N802
        path = urllib.parse.urlparse(self.path).path

        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try:
            req = json.loads(raw.decode() or "{}")
        except Exception:
            self._json(400, {"error": "bad json"})
            return

        if path == "/api/pair":
            code = str(req.get("code") or "").strip().replace(" ", "")
            auth = load_auth()
            if not auth.get("code_hash"):
                self._json(503, {"error": "pairing not initialized — reboot stick"})
                return
            if hashlib.sha256(code.encode()).hexdigest() != auth.get("code_hash"):
                self._json(403, {"error": "bad_code", "message": "Wrong code — check the stick screen."})
                return
            token = auth.get("pending_token") or secrets.token_urlsafe(32)
            auth["token_hash"] = token_hash(token)
            auth["paired"] = True
            auth.pop("pending_token", None)
            auth["code_hash"] = hashlib.sha256(secrets.token_bytes(16)).hexdigest()
            try:
                (RUN_DIR / "pair-code.txt").unlink(missing_ok=True)
            except Exception:
                pass
            save_auth(auth)
            msg = "Paired. This browser can chat and manage models until reboot or Disconnect."
            self._json(
                200,
                {
                    "ok": True,
                    "token": token,
                    "tls": TLS_ENABLED,
                    "chat_frontend": "native",
                    "message": msg,
                },
                extra=self._set_session_cookie(token),
            )
            return

        if path == "/api/pair/revoke":
            # Current valid Bearer/cookie OR loopback trust (same-box can mint a new LAN code).
            _doc, ok = self._auth()
            if not ok:
                self._json(401, {"error": "pair_required", "message": "Valid pair or local console required to revoke."})
                return
            try:
                mint_pair_code()
            except Exception as e:
                self._json(500, {"error": "revoke_failed", "message": str(e)})
                return
            # Confirm unpaired so /v1 returns 401 until the new code is entered.
            auth = load_auth()
            if auth.get("paired"):
                self._json(500, {"error": "revoke_failed", "message": "pair state still active after mint"})
                return
            self._json(
                200,
                {
                    "ok": True,
                    "paired": False,
                    "require_pair": True,
                    "hint": "New pair code is on the StickLLM screen. Enter it in the browser that should take over.",
                    "message": "Pair revoked. Previous browser session is invalid.",
                },
                extra=self._clear_session_cookie(),
            )
            return

        if path == "/api/control":
            doc, ok = self._auth()
            if not ok:
                self._json(401, {"error": "pair_required"})
                return
            action = str(req.get("action") or "")
            params = req.get("params") if isinstance(req.get("params"), dict) else {}
            try:
                timeout = 7200 if action == "model_download" else 180
                data = http_json(
                    CONTROL + "/action",
                    {"action": action, "params": params},
                    timeout=timeout,
                )
                self._json(200, data)
            except Exception as e:
                self._json(502, {"ok": False, "error": str(e)})
            return

        if path not in ("/v1/chat/completions", "/api/chat"):
            self._json(404, {"error": "not found"})
            return

        doc, ok = self._auth()
        if doc.get("require_pair") and not ok:
            self._json(401, {"error": "pair_required", "message": "Pair this browser using the code on the stick screen."})
            return

        messages = list(req.get("messages") or [])
        web_mode = req.get("web", "auto")
        if web_mode is True or web_mode == "on" or web_mode == "auto":
            use = True
            force = False
        else:
            use = False
            force = False

        hits: list[dict] = []
        out_messages = messages
        if use:
            out_messages, hits = augment_with_web(messages, force=force)

        upstream = {
            "model": req.get("model") or "stickllm",
            "messages": out_messages,
            "temperature": req.get("temperature", 0.7),
            "stream": False,
            "max_tokens": req.get("max_tokens", 1024),
        }
        try:
            data = http_json(LLAMA + "/v1/chat/completions", upstream, timeout=300)
            if hits:
                data["stickllm_web"] = {"used": True, "results": hits}
            else:
                data["stickllm_web"] = {"used": False, "results": []}
            self._json(200, data)
        except urllib.error.HTTPError as e:
            body = e.read()[:2000]
            self._send(e.code, body or json.dumps({"error": str(e)}).encode())
        except Exception as e:
            self._json(502, {"error": str(e), "trace": traceback.format_exc()[-500:]})

    def do_PUT(self) -> None:  # noqa: N802
        self._json(405, {"error": "method not allowed"})

    def do_DELETE(self) -> None:  # noqa: N802
        self._json(405, {"error": "method not allowed"})


class RedirectHandler(SimpleHTTPRequestHandler):
    """HTTP :80 → HTTPS :443 (pairing and chat are TLS-only when TLS is on)."""

    def log_message(self, fmt: str, *args) -> None:
        pass

    def do_GET(self) -> None:  # noqa: N802
        host = self.headers.get("Host", "stickllm").split(":")[0]
        loc = f"https://{host}:{PORT}{self.path}"
        body = b"Redirecting to HTTPS\n"
        self.send_response(301)
        self.send_header("Location", loc)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    do_POST = do_GET  # noqa: N815
    do_HEAD = do_GET  # noqa: N815


class ThreadingTLSServer(ThreadingHTTPServer):
    # ThreadingHTTPServer already includes ThreadingMixIn — do not mix it again (MRO error).
    daemon_threads = True


def resolve_tls_paths() -> tuple[Path, Path]:
    candidates = [
        (TLS_CERT, TLS_KEY),
        (Path("/mnt/stickllm-data/tls/cert.pem"), Path("/mnt/stickllm-data/tls/key.pem")),
        (Path("/var/lib/stickllm/tls/cert.pem"), Path("/var/lib/stickllm/tls/key.pem")),
    ]
    for crt, key in candidates:
        if crt.is_file() and key.is_file():
            return crt, key
    return TLS_CERT, TLS_KEY


def main() -> int:
    os.chdir(UI_ROOT)
    httpd = ThreadingTLSServer((HOST, PORT), Handler)

    if TLS_ENABLED:
        crt, key = resolve_tls_paths()
        if not crt.is_file() or not key.is_file():
            # Best-effort generate via helper
            os.system("/usr/local/bin/stickllm-tls >/dev/null 2>&1")
            crt, key = resolve_tls_paths()
        if not crt.is_file() or not key.is_file():
            print(f"stickllm-gateway: TLS requested but cert missing ({crt})", flush=True)
            return 1
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(str(crt), str(key))
        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
        scheme = "https"
        if HTTP_PORT > 0 and HTTP_PORT != PORT:
            redir = ThreadingHTTPServer((HOST, HTTP_PORT), RedirectHandler)

            def _run_redir() -> None:
                print(f"stickllm-gateway redirect http://{HOST}:{HTTP_PORT} -> https :{PORT}", flush=True)
                redir.serve_forever()

            threading.Thread(target=_run_redir, name="http-redirect", daemon=True).start()
    else:
        scheme = "http"

    print(
        f"stickllm-gateway on {scheme}://{HOST}:{PORT} -> {LLAMA} "
        f"control={CONTROL} frontend=native local_trust={int(LOCAL_TRUST)}",
        flush=True,
    )
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
