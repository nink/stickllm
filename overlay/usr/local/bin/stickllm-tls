#!/usr/bin/env bash
# Mint / refresh StickLLM LAN TLS material (self-signed, SAN = stickllm + LAN IPs).
# Active files always live in /var/lib/stickllm/tls. When USB DATA is mounted,
# mirror there so Persist boots can restore the same cert.
set -euo pipefail

ACTIVE="${STICKLLM_TLS_DIR:-/var/lib/stickllm/tls}"
DATA_TLS=""
if [[ -d /mnt/stickllm-data ]] && mountpoint -q /mnt/stickllm-data 2>/dev/null; then
  DATA_TLS="/mnt/stickllm-data/tls"
fi

CRT="$ACTIVE/cert.pem"
KEY="$ACTIVE/key.pem"
CFG="$ACTIVE/openssl.cnf"
META="$ACTIVE/meta.json"

mkdir -p "$ACTIVE"
chmod 700 "$ACTIVE"

# Restore from DATA if active is empty
if [[ -n "$DATA_TLS" && -s "$DATA_TLS/cert.pem" && -s "$DATA_TLS/key.pem" ]]; then
  if [[ ! -s "$CRT" || ! -s "$KEY" ]]; then
    cp -a "$DATA_TLS/cert.pem" "$CRT"
    cp -a "$DATA_TLS/key.pem" "$KEY"
    [[ -f "$DATA_TLS/meta.json" ]] && cp -a "$DATA_TLS/meta.json" "$META" || true
  fi
fi

collect_ips() {
  hostname -I 2>/dev/null | tr ' ' '\n' | awk 'NF && $1 !~ /^127\./' | head -12
}

need_new() {
  [[ ! -s "$CRT" || ! -s "$KEY" ]] && return 0
  openssl x509 -in "$CRT" -noout -checkend 86400 >/dev/null 2>&1 || return 0
  local ip san
  san="$(openssl x509 -in "$CRT" -noout -ext subjectAltName 2>/dev/null || true)"
  while read -r ip; do
    [[ -z "$ip" ]] && continue
    [[ "$san" == *"$ip"* ]] || return 0
  done < <(collect_ips)
  return 1
}

if ! need_new; then
  if [[ -n "$DATA_TLS" ]]; then
    mkdir -p "$DATA_TLS"
    cp -a "$CRT" "$KEY" "$DATA_TLS/" 2>/dev/null || true
    [[ -f "$META" ]] && cp -a "$META" "$DATA_TLS/" 2>/dev/null || true
  fi
  echo "$CRT"
  exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
  echo "stickllm-tls: openssl missing" >&2
  exit 1
fi

mapfile -t IPS < <(collect_ips)

{
  echo "[req]"
  echo "default_bits = 2048"
  echo "prompt = no"
  echo "default_md = sha256"
  echo "distinguished_name = dn"
  echo "x509_extensions = v3_req"
  echo
  echo "[dn]"
  echo "CN = stickllm"
  echo "O = StickLLM"
  echo "OU = LAN self-signed"
  echo
  echo "[v3_req]"
  echo "basicConstraints = CA:FALSE"
  echo "keyUsage = digitalSignature, keyEncipherment"
  echo "extendedKeyUsage = serverAuth"
  echo "subjectAltName = @alt"
  echo
  echo "[alt]"
  echo "DNS.1 = stickllm"
  echo "DNS.2 = localhost"
  echo "IP.1 = 127.0.0.1"
  n=2
  for ip in "${IPS[@]}"; do
    [[ -z "$ip" ]] && continue
    echo "IP.${n} = ${ip}"
    n=$((n + 1))
  done
} >"$CFG"

openssl req -x509 -newkey rsa:2048 -nodes \
  -keyout "$KEY" -out "$CRT" -days 825 \
  -config "$CFG" >/dev/null 2>&1

chmod 600 "$KEY"
chmod 644 "$CRT"

FP="$(openssl x509 -in "$CRT" -noout -fingerprint -sha256 | awk -F= '{print $2}')"
printf '%s\n' "{\"cert\":\"$CRT\",\"fingerprint_sha256\":\"$FP\"}" >"$META"

if [[ -n "$DATA_TLS" ]]; then
  mkdir -p "$DATA_TLS"
  cp -a "$CRT" "$KEY" "$META" "$DATA_TLS/" 2>/dev/null || true
fi

echo "$CRT"
