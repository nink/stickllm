#!/bin/bash
# Ensure live user can log in (console + SSH) with a known ephemeral password.
# CRITICAL: never systemctl daemon-reload here — mid-boot reload cancels the
# pending stickllm-bootstatus job (v0.2.1 regression) and leaves the systemd
# splash stuck on NetworkManager forever with no pair code on tty1.
set -euo pipefail

if ! getent passwd user >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo,video,render user 2>/dev/null || true
fi

if getent passwd user >/dev/null 2>&1; then
  echo 'user:stickllm' | chpasswd
  usermod -aG sudo,video,render user 2>/dev/null || true
fi

# Passwordless sudo for diagnostics on this ephemeral stick
cat >/etc/sudoers.d/stickllm-user <<'EOF'
user ALL=(ALL) NOPASSWD:ALL
EOF
chmod 440 /etc/sudoers.d/stickllm-user

# Quiet banner for SSH / console
cat >/etc/motd <<'EOF'

  StickLLM v0.3 — ephemeral Privacy AI (TLS on :443)
  stickllm-status   nvidia-smi   curl -sk https://127.0.0.1/health
  Pair code: cat /run/stickllm/pair-code.txt
  tty1 = status/READY   |   tty2 = local login (Ctrl+Alt+F2)

EOF

# Quiet kernel spam on the console so EXT4/USB noise does not bury the pair code.
sysctl -w kernel.printk="3 4 1 3" >/dev/null 2>&1 || true
dmesg -n err >/dev/null 2>&1 || true

# Drop plymouth / splash so tty1 pair paint is visible.
plymouth quit --wait >/dev/null 2>&1 || true

# Term/local keyboard login on tty2 — tty1 is owned by bootstatus (pair code).
systemctl enable getty@tty2.service 2>/dev/null || true
systemctl start getty@tty2.service 2>/dev/null || true
# getty@tty1 gated by overlay drop-in ConditionPathExists=/run/stickllm/allow-getty-tty1
systemctl stop getty@tty1.service 2>/dev/null || true
# Re-queue bootstatus (idempotent). --no-block so this oneshot can exit.
systemctl start --no-block stickllm-bootstatus.service 2>/dev/null || true
