#!/usr/bin/env python3
"""Create / refresh StickLLM LAN pair code (shown only on the stick console)."""
from __future__ import annotations

import hashlib
import json
import os
import secrets
import sys
import time
from pathlib import Path

RUN = Path(os.environ.get("STICKLLM_RUN", "/run/stickllm"))
AUTH = RUN / "auth.json"


def main() -> int:
    force = "--force" in sys.argv
    RUN.mkdir(parents=True, exist_ok=True)
    # Service restarts must not wipe an active browser session.
    if AUTH.is_file() and not force:
        try:
            old = json.loads(AUTH.read_text(encoding="utf-8"))
            if old.get("paired") and old.get("token_hash"):
                code_path = RUN / "pair-code.txt"
                if code_path.is_file():
                    print(code_path.read_text(encoding="utf-8").strip() or "PAIRED")
                else:
                    print("PAIRED")
                return 0
            if old.get("code_hash") and code_path_exists_with_code():
                print((RUN / "pair-code.txt").read_text(encoding="utf-8").strip())
                return 0
        except Exception:
            pass

    code = f"{secrets.randbelow(1_000_000):06d}"
    token = secrets.token_urlsafe(32)
    # Store hash of code; plaintext code only printed to stdout for bootstatus
    code_hash = hashlib.sha256(code.encode()).hexdigest()
    doc = {
        "version": 1,
        "created": int(time.time()),
        "code_hash": code_hash,
        "token_hash": hashlib.sha256(token.encode()).hexdigest(),
        # token kept for gateway to issue after successful pair (rotated on pair)
        "pending_token": token,
        "paired": False,
        "require_pair": True,
    }
    AUTH.write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")
    os.chmod(AUTH, 0o600)
    # Machine-readable for bootstatus
    # World-readable on the stick only — code is meant to be seen on the console.
    # auth.json stays 0600 (hashes / token material).
    (RUN / "pair-code.txt").write_text(code + "\n", encoding="utf-8")
    os.chmod(RUN / "pair-code.txt", 0o644)
    print(code)
    return 0


def code_path_exists_with_code() -> bool:
    p = RUN / "pair-code.txt"
    try:
        return p.is_file() and bool(p.read_text(encoding="utf-8").strip())
    except Exception:
        return False


if __name__ == "__main__":
    raise SystemExit(main())
