#!/usr/bin/env python3
"""Root control daemon — USB claim, model probe/download/activate, status."""
from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from socketserver import ThreadingMixIn

RUN = Path(os.environ.get("STICKLLM_RUN", "/run/stickllm"))
CATALOG = Path(os.environ.get("STICKLLM_CATALOG", "/etc/stickllm/models/catalog.toml"))
MNT = Path(os.environ.get("STICKLLM_DATA_MNT", "/mnt/stickllm-data"))
HOST = "127.0.0.1"
PORT = int(os.environ.get("STICKLLM_CONTROL_PORT", "8091"))
BAKED_VL = Path("/opt/stickllm/models/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf")
BAKED_VL_MMPROJ = Path("/opt/stickllm/models/mmproj-Qwen2.5-VL-3B-Instruct-Q8_0.gguf")
BAKED_3B = Path("/opt/stickllm/models/qwen2.5-3b-instruct-q4_k_m.gguf")


def sh(cmd: list[str], timeout: int = 600) -> dict:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
        return {
            "ok": p.returncode == 0,
            "code": p.returncode,
            "stdout": (p.stdout or "")[-8000:],
            "stderr": (p.stderr or "")[-4000:],
        }
    except Exception as e:
        return {"ok": False, "error": str(e)}


def read_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def model_dirs() -> list[Path]:
    dirs: list[Path] = []
    data = MNT / "models"
    if data.is_dir():
        dirs.append(data)
    baked = Path("/opt/stickllm/models")
    if baked.is_dir():
        dirs.append(baked)
    return dirs


def find_file(name: str) -> Path | None:
    for d in model_dirs():
        p = d / name
        if p.is_file() and p.stat().st_size > 1_000_000:
            return p
    return None


def detect_vram_gb() -> float:
    try:
        p = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=memory.total",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        vals = [float(x.strip()) for x in p.stdout.splitlines() if x.strip()]
        if not vals:
            return 0.0
        return max(vals) / 1024.0
    except Exception:
        return 0.0


def active_model_path() -> str:
    env = RUN / "model.env"
    if env.is_file():
        for line in env.read_text(encoding="utf-8").splitlines():
            if line.startswith("STICKLLM_MODEL="):
                return line.split("=", 1)[1].strip()
    cur = RUN / "current.gguf"
    if cur.is_symlink() or cur.is_file():
        try:
            return str(cur.resolve())
        except Exception:
            pass
    if BAKED_VL.is_file():
        return str(BAKED_VL)
    if BAKED_3B.is_file():
        return str(BAKED_3B)
    return ""


def split_hf_files(files: list[str]) -> tuple[str | None, str | None]:
    main = None
    mmproj = None
    for f in files:
        if "mmproj" in f.lower():
            if mmproj is None:
                mmproj = f
        elif main is None:
            main = f
    return main, mmproj


def last_model_path() -> Path:
    return MNT / "etc" / "stickllm" / "last-model.json"


def save_last_model(model_id: str, name: str = "") -> None:
    """Remember active model on STICKLLM-DATA so reboot restores it when VRAM still fits."""
    if not model_id:
        return
    try:
        if not os.path.ismount(str(MNT)):
            return
        dest = last_model_path()
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(
            json.dumps(
                {
                    "id": model_id,
                    "name": name or model_id,
                    "updated": int(time.time()),
                },
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
    except Exception:
        pass


def write_model_env(
    model_path: str,
    mmproj_path: str = "",
    model_id: str = "",
    name: str = "",
    n_gpu_layers: int | None = None,
) -> None:
    vram = detect_vram_gb()
    if n_gpu_layers is None:
        n_gpu_layers = 0 if vram < 0.5 else 999
    if vram < 0.5:
        mmproj_path = ""
    RUN.mkdir(parents=True, exist_ok=True)
    (RUN / "model.env").write_text(
        "\n".join(
            [
                f"STICKLLM_MODEL={shlex.quote(model_path)}",
                f"STICKLLM_MMPROJ={shlex.quote(mmproj_path)}",
                f"STICKLLM_N_GPU_LAYERS={int(n_gpu_layers)}",
                f"STICKLLM_MODEL_ID={shlex.quote(model_id)}",
                f"STICKLLM_MODEL_NAME={shlex.quote(name)}",
            ]
        )
        + "\n",
        encoding="utf-8",
    )
    if model_id:
        save_last_model(model_id, name)


def parse_catalog() -> list[dict]:
    if not CATALOG.is_file():
        return []
    text = CATALOG.read_text(encoding="utf-8")
    out = []
    for b in re.split(r"\n\[\[model\]\]\n", text)[1:]:
        def g(key: str, default: str = "") -> str:
            m = re.search(rf"^{key}\s*=\s*(.+)$", b, re.M)
            if not m:
                return default
            return m.group(1).strip().strip('"')

        mid = g("id")
        if not mid:
            continue
        repo = g("hf_repo", "")
        fm = re.search(r"^hf_files\s*=\s*\[(.*?)\]", b, re.M | re.S)
        files = re.findall(r'"([^"]*)"', fm.group(1)) if fm else []
        out.append(
            {
                "id": mid,
                "name": g("name", mid),
                "tier": g("tier"),
                "approx_size_gb": float(g("approx_size_gb", "0") or 0),
                "min_vram_gb": float(g("min_vram_gb", "0") or 0),
                "quality_rank": int(float(g("quality_rank", "0") or 0)),
                "vision": g("vision", "false").lower() == "true",
                "pinned": bool(repo) and bool(files),
                "hf_repo": repo,
                "hf_files": files,
                "notes": g("notes"),
            }
        )
    out.sort(key=lambda m: -m["quality_rank"])
    return out


def enrich_models(vram_gb: float | None = None) -> list[dict]:
    if vram_gb is None:
        vram_gb = detect_vram_gb()
    active = active_model_path()
    models = parse_catalog()
    for m in models:
        files = m.get("hf_files") or []
        paths = [find_file(f) for f in files] if files else []
        installed = bool(files) and all(p is not None for p in paths)
        if not installed and m["id"] == "qwen25-vl-3b-q4km" and BAKED_VL.is_file() and BAKED_VL_MMPROJ.is_file():
            installed = True
            paths = [BAKED_VL, BAKED_VL_MMPROJ]
        if not installed and m["id"] == "qwen25-3b-q4km" and BAKED_3B.is_file():
            installed = True
            paths = [BAKED_3B]
        main_name, mmproj_name = split_hf_files(files)
        main_path = find_file(main_name) if main_name else None
        mmproj_path = find_file(mmproj_name) if mmproj_name else None
        if m["id"] == "qwen25-vl-3b-q4km" and BAKED_VL.is_file():
            main_path = main_path or BAKED_VL
            mmproj_path = mmproj_path or (BAKED_VL_MMPROJ if BAKED_VL_MMPROJ.is_file() else None)
        if m["id"] == "qwen25-3b-q4km" and BAKED_3B.is_file():
            main_path = main_path or BAKED_3B
        first = str(main_path) if main_path else (next((str(p) for p in paths if p), ""))
        fits = vram_gb + 0.01 >= float(m.get("min_vram_gb") or 0)
        # CPU/RAM: allow min_vram 0 even with no GPU
        if float(m.get("min_vram_gb") or 0) == 0:
            fits = True
        # Vision models need GPU VRAM — hide runnable on CPU hosts
        if m.get("vision") and vram_gb < 0.5:
            fits = False
        runnable = installed and fits and bool(first)
        if m.get("vision") and installed and not mmproj_path:
            runnable = False
        is_active = False
        if active and first:
            try:
                is_active = Path(active).resolve() == Path(first).resolve()
            except Exception:
                is_active = os.path.basename(active) == os.path.basename(first)
        m.update(
            {
                "installed": installed,
                "runnable": runnable,
                "active": is_active,
                "fits_vram": fits,
                "path": first,
                "mmproj": str(mmproj_path) if mmproj_path else "",
                "vram_gb": round(vram_gb, 1),
            }
        )
    return models


def download_progress() -> dict:
    """Best-effort download progress from progress file or *.partial sizes."""
    prog = read_json(RUN / "download-progress.json")
    if prog.get("state") in ("downloading", "verifying", "starting"):
        # If the final GGUF is already present and no .partial remains, treat as done
        # (avoids a stuck 99% bar after mv/hash).
        mid = prog.get("id") or ""
        still_partial = False
        for d in model_dirs():
            try:
                if any(d.glob("*.partial")):
                    still_partial = True
                    break
            except OSError:
                pass
        if not still_partial and mid and not download_running():
            for m in parse_catalog():
                if m.get("id") == mid:
                    files = m.get("hf_files") or []
                    if files and all(find_file(f) for f in files):
                        return {
                            "state": "done",
                            "id": mid,
                            "name": m.get("name", mid),
                            "percent": 100.0,
                            "bytes_done": prog.get("bytes_total") or 0,
                            "bytes_total": prog.get("bytes_total") or 0,
                            "note": "complete",
                        }
        return prog

    # Infer from in-flight .partial files (works even if writer isn't running yet).
    partials: list[tuple[Path, int]] = []
    for d in model_dirs():
        try:
            for p in d.glob("*.partial"):
                try:
                    partials.append((p, p.stat().st_size))
                except OSError:
                    pass
        except OSError:
            pass
    if not partials:
        # Also detect active download process
        try:
            p = subprocess.run(
                ["pgrep", "-f", "stickllm-download-model|curl.*huggingface"],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
            if p.returncode == 0 and p.stdout.strip():
                return {
                    "state": "downloading",
                    "id": "",
                    "name": "model download",
                    "percent": None,
                    "bytes_done": 0,
                    "bytes_total": 0,
                    "note": "download running (size unknown yet)",
                }
        except Exception:
            pass
        return {"state": "idle"}

    # Prefer largest partial; match catalog entry by filename stem
    partials.sort(key=lambda x: -x[1])
    path, done = partials[0]
    base = path.name[: -len(".partial")] if path.name.endswith(".partial") else path.name
    models = parse_catalog()
    match = None
    for m in models:
        files = m.get("hf_files") or []
        if base in files or any(base == f or f.endswith(base) for f in files):
            match = m
            break
    total = 0
    if match:
        total = int(float(match.get("approx_size_gb") or 0) * (1024**3))
        # If multi-file, scale roughly by file count
        n = max(len(match.get("hf_files") or []), 1)
        if n > 1:
            total = max(total // n, done)
    percent = None
    if total > 0:
        percent = max(0.0, min(99.5, round(100.0 * done / total, 1)))
    return {
        "state": "downloading",
        "id": (match or {}).get("id", ""),
        "name": (match or {}).get("name", base),
        "file": base,
        "percent": percent,
        "bytes_done": done,
        "bytes_total": total,
        "path": str(path),
    }


def download_running() -> bool:
    try:
        p = subprocess.run(
            ["pgrep", "-f", "/usr/local/bin/stickllm-download-model"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        return p.returncode == 0 and bool(p.stdout.strip())
    except Exception:
        return False


def maybe_resume_stalled_download() -> dict | None:
    """If a .partial exists but no downloader is running, poke it again.

    Called from status polling so the Models UI watchdog can recover HF drops
    without the user noticing a frozen 50% bar forever.
    """
    import time

    prog = download_progress()
    if prog.get("state") == "done":
        return None
    if download_running():
        return None
    # Need an incomplete partial to resume
    has_partial = False
    partial_id = ""
    for d in model_dirs():
        try:
            for p in d.glob("*.partial"):
                if p.stat().st_size > 1_000_000:
                    has_partial = True
                    base = p.name[: -len(".partial")]
                    for m in parse_catalog():
                        if base in (m.get("hf_files") or []):
                            partial_id = m["id"]
                            break
                    break
        except OSError:
            pass
        if has_partial:
            break
    if not has_partial:
        return None

    stamp = RUN / "download-watchdog.json"
    now = int(time.time())
    last = read_json(stamp)
    # Cooldown 90s so status polls don't fork a storm
    if now - int(last.get("last_resume") or 0) < 90:
        return {"skipped": True, "reason": "cooldown"}

    mid = partial_id or str(prog.get("id") or "")
    cmd = ["/usr/local/bin/stickllm-download-model", "--i-understand"]
    if mid:
        cmd += ["--id", mid]
    RUN.mkdir(parents=True, exist_ok=True)
    log = RUN / "download.log"
    with open(log, "ab") as lf:
        lf.write(f"\n# watchdog resume {now} id={mid}\n".encode())
        subprocess.Popen(cmd, stdout=lf, stderr=subprocess.STDOUT, start_new_session=True)
    stamp.write_text(
        json.dumps({"last_resume": now, "id": mid, "reason": "stalled_partial"}) + "\n",
        encoding="utf-8",
    )
    return {"resumed": True, "id": mid}


def llm_ready() -> bool:
    try:
        import urllib.request

        with urllib.request.urlopen("http://127.0.0.1:8080/health", timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


def load_status() -> dict:
    phase = ""
    target = ""
    try:
        if (RUN / "load-phase.txt").is_file():
            phase = (RUN / "load-phase.txt").read_text(encoding="utf-8").strip()
        if (RUN / "load-model.txt").is_file():
            target = (RUN / "load-model.txt").read_text(encoding="utf-8").strip()
    except Exception:
        pass
    ready = llm_ready()
    if ready and phase in ("loading", "restarting"):
        try:
            (RUN / "load-phase.txt").write_text("ready\n", encoding="utf-8")
            phase = "ready"
        except Exception:
            phase = "ready"
    loading = (not ready) or phase in ("loading", "restarting")
    return {
        "ready": ready,
        "loading": loading,
        "phase": phase or ("ready" if ready else "down"),
        "target": target,
        "active_model": active_model_path(),
    }


def activate_model(model_id: str) -> dict:
    models = enrich_models()
    m = next((x for x in models if x["id"] == model_id), None)
    if not m:
        return {"ok": False, "error": f"unknown model: {model_id}"}
    if not m.get("installed"):
        return {"ok": False, "error": "model not downloaded yet"}
    if not m.get("fits_vram"):
        return {
            "ok": False,
            "error": f"needs {m['min_vram_gb']} GB VRAM; this host has ~{m['vram_gb']} GB",
        }
    path = m.get("path") or ""
    if not path or not Path(path).is_file():
        return {"ok": False, "error": "model file missing"}
    mmproj = m.get("mmproj") or ""
    if m.get("vision") and (not mmproj or not Path(mmproj).is_file()):
        return {"ok": False, "error": "vision mmproj missing"}
    RUN.mkdir(parents=True, exist_ok=True)
    write_model_env(path, mmproj, model_id, m.get("name", model_id))
    (RUN / "load-phase.txt").write_text("loading\n", encoding="utf-8")
    (RUN / "load-model.txt").write_text(f"{model_id}\n{m.get('name', model_id)}\n", encoding="utf-8")
    try:
        cur = RUN / "current.gguf"
        if cur.exists() or cur.is_symlink():
            cur.unlink()
        cur.symlink_to(path)
    except Exception:
        pass
    # Restart returns when the process is spawned — VRAM load continues after.
    r = sh(["systemctl", "restart", "stickllm-llama.service"], timeout=60)
    (RUN / "load-phase.txt").write_text("loading\n", encoding="utf-8")
    r["ok"] = r.get("code", 1) == 0
    r["loading"] = True
    r["active_model"] = path
    r["id"] = model_id
    r["name"] = m.get("name", model_id)
    r["models"] = enrich_models()
    r["llm"] = load_status()
    return r


def handle(action: str, params: dict) -> dict:
    if action == "status":
        vram = detect_vram_gb()
        models = enrich_models(vram)
        watchdog = maybe_resume_stalled_download()
        return {
            "ok": True,
            "storage": read_json(RUN / "storage.json"),
            "probe": read_json(RUN / "model-probe.json"),
            "boot_phase": (RUN / "boot-phase.txt").read_text(encoding="utf-8").strip()
            if (RUN / "boot-phase.txt").is_file()
            else "",
            "vram_gb": round(vram, 1),
            "active_model": active_model_path(),
            "catalog": models,
            "download": download_progress(),
            "download_watchdog": watchdog,
            "llm": load_status(),
        }
    if action == "usb_claim":
        r = sh(["/usr/local/bin/stickllm-usb-claim", "--auto", "--yes"], timeout=180)
        r["storage"] = read_json(RUN / "storage.json")
        return r
    if action == "model_probe":
        r = sh(["/usr/local/bin/stickllm-model-probe"], timeout=60)
        r["probe"] = read_json(RUN / "model-probe.json")
        r["catalog"] = enrich_models()
        return r
    if action == "model_download":
        mid = str(params.get("id") or "").strip()
        if download_running():
            return {
                "ok": True,
                "started": False,
                "already_running": True,
                "download": download_progress(),
                "catalog": enrich_models(),
            }
        cmd = ["/usr/local/bin/stickllm-download-model", "--i-understand"]
        if mid:
            cmd += ["--id", mid]
        # Background so the UI can poll download progress.
        log = RUN / "download.log"
        RUN.mkdir(parents=True, exist_ok=True)
        with open(log, "ab") as lf:
            subprocess.Popen(
                cmd,
                stdout=lf,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        return {
            "ok": True,
            "started": True,
            "id": mid,
            "download": download_progress(),
            "catalog": enrich_models(),
        }
    if action == "model_activate":
        mid = str(params.get("id") or "").strip()
        if not mid:
            return {"ok": False, "error": "id required"}
        return activate_model(mid)
    if action == "catalog":
        return {"ok": True, "models": enrich_models()}
    if action == "ssd_status":
        return {
            "ok": True,
            "enabled": False,
            "note": "Opt-in SSD cache not implemented yet — USB DATA only for now.",
        }
    return {"ok": False, "error": f"unknown action: {action}"}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _send(self, code: int, obj: dict) -> None:
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:  # noqa: N802
        if self.path not in ("/", "/action"):
            self._send(404, {"ok": False, "error": "not found"})
            return
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try:
            req = json.loads(raw.decode() or "{}")
        except Exception:
            self._send(400, {"ok": False, "error": "bad json"})
            return
        action = str(req.get("action") or "")
        params = req.get("params") or {}
        if not isinstance(params, dict):
            params = {}
        result = handle(action, params)
        self._send(200 if result.get("ok", True) or "code" in result else 500, result)


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True


def main() -> int:
    RUN.mkdir(parents=True, exist_ok=True)
    httpd = ThreadedHTTPServer((HOST, PORT), Handler)
    print(f"stickllm-control on http://{HOST}:{PORT}", flush=True)
    httpd.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
