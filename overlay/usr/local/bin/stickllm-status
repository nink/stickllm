#!/bin/bash
set -euo pipefail

MODE="${STICKLLM_MODE:-ephemeral}"
if [[ -f /etc/stickllm/runtime.env ]]; then
  # shellcheck disable=SC1091
  source /etc/stickllm/runtime.env || true
  MODE="${STICKLLM_MODE:-$MODE}"
fi

echo "=== StickLLM status ==="
echo "mode:     $MODE"
echo "profile:  amd-rtx3090"
echo

if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || echo "nvidia-smi: error"
  if [[ -f /run/stickllm/cuda.env ]]; then
    echo "cuda.env: $(tr '\n' ' ' </run/stickllm/cuda.env)"
  fi
else
  echo "nvidia-smi: not found"
fi
echo

MODEL=""
if [[ -f /run/stickllm/model.env ]]; then
  # shellcheck disable=SC1091
  source /run/stickllm/model.env || true
  MODEL="${STICKLLM_MODEL:-}"
fi
if [[ -z "$MODEL" ]]; then
  for c in \
    /opt/stickllm/models/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf \
    /opt/stickllm/models/qwen2.5-3b-instruct-q4_k_m.gguf; do
    [[ -f "$c" ]] && MODEL="$c" && break
  done
fi
if [[ -n "$MODEL" && -f "$MODEL" ]]; then
  echo "model:    ${STICKLLM_MODEL_NAME:-$(basename "$MODEL")} ($(du -h "$MODEL" | awk '{print $1}'))"
else
  echo "model:    MISSING — use Models menu or stickllm-download-model"
fi

echo "llama:    $(systemctl is-active stickllm-llama.service 2>/dev/null || echo unknown)"
echo "ui:       $(systemctl is-active stickllm-ui.service 2>/dev/null || echo unknown)"
echo "tls:      $(systemctl is-active stickllm-tls.service 2>/dev/null || echo unknown)"
echo "kiosk:    $(systemctl is-active stickllm-kiosk.service 2>/dev/null || echo inactive)"
echo "frontend: native"
echo "local_trust: ${STICKLLM_LOCAL_TRUST:-1}"
echo

IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
if [[ -n "${IP:-}" ]]; then
  echo "Chat UI:  https://${IP}/  (LAN: pair code required)"
  echo "API:      https://${IP}/v1/chat/completions"
else
  echo "Chat UI:  https://127.0.0.1/  (same-box: no pair)"
  echo "API:      https://127.0.0.1/v1/chat/completions"
fi
if [[ -f /var/lib/stickllm/tls/cert.pem ]]; then
  echo "TLS FP:   $(openssl x509 -in /var/lib/stickllm/tls/cert.pem -noout -fingerprint -sha256 2>/dev/null | awk -F= '{print $2}')"
fi

if [[ -d /lib/live/mount/persistence ]] || mount | grep -q persistence; then
  echo
  echo "persistence: active (USB data partition)"
else
  echo
  echo "persistence: off (ephemeral — reboot clears session)"
fi
